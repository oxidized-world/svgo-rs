{
  "name": "@svg-rs/svgo",
  "version": "0.0.6",
  "description": "Node.js tool for optimizing SVG files by Rust.",
  "main": "index.js",
  "repository": "https://github.com/oxidized-world/svgo-rs",
  "license": "MIT",
  "keywords": [
    "napi-rs",
    "NAPI",
    "Rust",
    "svgo",
    "svg optimizing"
  ],
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "napi": {
    "binaryName": "svgo-rs",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-musl",
      "wasm32-wasip1-threads"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "format": "format:rs && format:toml",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "biome lint --write",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "napi version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@emnapi/core": "^2.0.0-alpha.4",
    "@emnapi/runtime": "^2.0.0-alpha.4",
    "@napi-rs/cli": "^3.8.6",
    "@napi-rs/wasm-runtime": "^1.2.3",
    "@oxc-node/core": "^0.1.0",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.3",
    "@types/node": "^26.2.0",
    "emnapi": "^2.0.0-alpha.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "svgo": "^4.0.2",
    "tinybench": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.@(js|ts|tsx|json)": [
      "biome lint --write"
    ],
    "*.toml": [
      "taplo format"
    ],
    "*.rs": [
      "cargo fmt --"
    ]
  },
  "packageManager": "yarn@4.18.0"
}
