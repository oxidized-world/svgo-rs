exports[`optimize > move-attrs-transform.svg 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
  <g transform="translate(1 2) scale(2)" fill="red">
    <rect width="1" height="1"/>
    <rect width="2" height="2"/>
  </g>
  <g transform="scale(3)" fill="blue">
    <ellipse rx="1" ry="1"/>
    <ellipse rx="2" ry="2"/>
  </g>
  <g filter="url(#f)" fill="green">
    <rect transform="scale(4)" width="1" height="1"/>
    <rect transform="scale(4)" width="2" height="2"/>
  </g>
  <g clip-path="url(#c)" fill="teal">
    <rect transform="scale(5)" width="1" height="1"/>
    <rect transform="scale(5)" width="2" height="2"/>
  </g>
  <g mask="url(#m)" fill="olive">
    <rect transform="scale(6)" width="1" height="1"/>
    <rect transform="scale(6)" width="2" height="2"/>
  </g>
</svg>
"
`;

