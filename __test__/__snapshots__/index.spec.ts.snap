exports[`optimize > basic.svg 1`] = `
"
<svg width="100px" height="100px" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:myeditor="http://www.myeditor.com/ns" version="1.1">
    <myeditor:metadata>
        <myeditor:source>AwesomeIcon Design</myeditor:source>
        <myeditor:version>1.2</myeditor:version>
        <myeditor:exporter>MyEditor Pro Exporter v3.0</myeditor:exporter>
    </myeditor:metadata>
    
    
    <g id="BackgroundLayer" myeditor:layerName="Background" fill="blue">
        <circle cx="50" cy="50" r="45" id="blue_circle_bg" myeditor:objectID="obj123"/>
    </g>
    <g id="ForegroundLayer" myeditor:layerName="Foreground" myeditor:isDecorative="false" fill="red">
        <polygon points="50,15 61,35 85,35 67,50 73,70 50,60 27,70 33,50 15,35 39,35" id="red_star_shape" myeditor:objectID="obj456" myeditor:customAttribute="important_shape"/>
    </g>
</svg>
"
`;

