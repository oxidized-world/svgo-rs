exports[`optimize > comments.svg 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
  
  <!--! a legal comment that must be preserved -->
  <!--!
    multi-line preserved comment
  -->
  <!--! preserved with entity: Tom & Jerry and 3 < 5 -->
  <rect width="10" height="10"/>
  <g>
    
    <!--! nested preserved comment -->
    <circle cx="5" cy="5" r="2"/>
  </g>
</svg>
"
`;

